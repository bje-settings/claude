{
  "name": "bje-claude-plugins",
  "private": true,
  "type": "module",
  "imports": {
    "#harness/*": "./harness/*",
    "#lib/*": "./lib/*",
    "#audit/*": "./plugins/audit/src/*",
    "#gh/*": "./plugins/gh/src/*",
    "#mermaid/*": "./plugins/mermaid/src/*",
    "#shepherd/*": "./plugins/shepherd/src/*",
    "#workstreams/*": "./plugins/workstreams/src/*"
  },
  "description": "Dev and CI toolchain for the marketplace. Not a shipped package and not a dependency of any plugin: plugins never carry a package.json (RFC 001 decision 13, docs/rfc/001-typescript-port.md).",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.18.0 <23"
  },
  "scripts": {
    "test": "vitest run --coverage",
    "lint": "eslint --flag unstable_native_nodejs_ts_config --max-warnings 0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "@eslint/json": "2.1.0",
    "@eslint/markdown": "8.0.3",
    "@types/node": "22.20.2",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.11.0",
    "eslint-plugin-claude": "0.9.1",
    "lefthook": "2.1.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "lefthook"
    ],
    "overrides": {
      "katex": "^0.18.2",
      "source-map-js": "^1.2.2"
    }
  }
}
