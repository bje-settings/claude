#!/usr/bin/env python3
"""A stand-in for the gh CLI, for the field-test tests. Put this directory on PATH,
or point FT_GH at it.

The Python counterpart of `fixtures/field-test/bin/gh`, covering the run side:
the enterprise query, the duplicate-issue search, and the label. Like that stub
it does not fake the output of the script under test: it holds canned answers,
applies the filtering the real gh applies server-side, and projects the fields
named by --json. Anything it does not emulate is an error, so a test cannot pass
against a query the real gh would answer differently: an unknown flag exits 64,
an unknown --json field exits 1 like gh's "Unknown JSON field", and an unemulated
subcommand exits 1.

Controlled by:
  FT_GH_FIXTURE_DIR   directory holding issues.json and enterprise-mode
  FT_GH_FIXTURE_FAIL  if non-empty, every call exits non-zero

enterprise-mode picks the answer to the enterprise query:
  both     one enterprise, acme-org and acme-tools both in it
  neither  one enterprise holding only acme-org
  paged    acme-org on the first page, acme-tools on the second
  second   two enterprises; only the second holds both owners
  error    the query fails
  empty    a well-formed response with no enterprises node
"""

import json
import os
import sys

FLAGS_WITH_VALUES = (
    "--repo",
    "--state",
    "--label",
    "--search",
    "--json",
    "--color",
    "--description",
)


def fail(message, status=1):
    sys.stderr.write(f"gh stub: {message}\n")
    sys.exit(status)


def fixture_dir():
    return os.environ.get("FT_GH_FIXTURE_DIR") or ""


def read_fixture(name, default):
    path = os.path.join(fixture_dir(), name)
    try:
        with open(path) as handle:
            return json.load(handle)
    except (OSError, ValueError):
        return default


def enterprise_mode():
    path = os.path.join(fixture_dir(), "enterprise-mode")
    try:
        with open(path) as handle:
            return handle.read().strip() or "both"
    except OSError:
        return "both"


def parse(argv):
    """(options, positional arguments), refusing anything the real gh would take."""
    options = {"-f": []}
    positional = []
    index = 0
    while index < len(argv):
        argument = argv[index]
        if argument == "-f":
            index += 1
            if index >= len(argv):
                fail("-f needs a value")
            options["-f"].append(argv[index])
        elif argument in FLAGS_WITH_VALUES:
            index += 1
            if index >= len(argv):
                fail(f"{argument} needs a value")
            options[argument] = argv[index]
        elif argument == "--force":
            options["--force"] = "1"
        elif argument.startswith("-"):
            fail(f"unhandled flag: {argument}", 64)
        else:
            if positional:
                fail(f"unexpected second argument: {argument}")
            positional.append(argument)
        index += 1
    return options, positional


def field_values(options):
    """The -f name=value pairs, as a dict."""
    values = {}
    for pair in options["-f"]:
        name, _, value = pair.partition("=")
        values[name] = value
    return values


def project(document, fields):
    """Only the fields --json named, the way gh projects them."""
    if not fields:
        return document
    names = fields.split(",")

    def pick(record):
        picked = {}
        for name in names:
            if name not in record:
                fail(f'Unknown JSON field: "{name}"')
            picked[name] = record[name]
        return picked

    if isinstance(document, list):
        return [pick(record) for record in document]
    return pick(document)


def viewer_page(logins, more, cursor):
    return {
        "data": {
            "viewer": {
                "enterprises": {
                    "nodes": [
                        {
                            "slug": "acme",
                            "organizations": {
                                "pageInfo": {"hasNextPage": more, "endCursor": cursor},
                                "nodes": [{"login": login} for login in logins],
                            },
                        }
                    ]
                }
            }
        }
    }


def two_viewer_pages():
    """Two enterprises, the first holding neither owner.

    A reader that stops at the first node gets the wrong answer.
    """

    def node(slug, logins):
        return {
            "slug": slug,
            "organizations": {
                "pageInfo": {"hasNextPage": False, "endCursor": None},
                "nodes": [{"login": login} for login in logins],
            },
        }

    return {
        "data": {
            "viewer": {
                "enterprises": {
                    "nodes": [
                        node("other", ["unrelated-org"]),
                        node("acme", ["acme-org", "acme-tools"]),
                    ]
                }
            }
        }
    }


def enterprise_page(logins, more, cursor):
    return {
        "data": {
            "enterprise": {
                "organizations": {
                    "pageInfo": {"hasNextPage": more, "endCursor": cursor},
                    "nodes": [{"login": login} for login in logins],
                }
            }
        }
    }


def api_graphql(options):
    values = field_values(options)
    query = values.get("query")
    if not query:
        fail("api graphql needs -f query=...")
    mode = enterprise_mode()
    if mode == "error":
        sys.stderr.write("gh: Your token has not been granted the required scopes\n")
        sys.exit(1)
    if mode == "empty":
        sys.stdout.write(json.dumps({"data": {"viewer": {}}}))
        return
    if "viewer" in query:
        if mode == "both":
            answer = viewer_page(["acme-org", "acme-tools"], False, None)
        elif mode == "neither":
            answer = viewer_page(["acme-org"], False, None)
        elif mode == "paged":
            answer = viewer_page(["acme-org"], True, "CURSOR1")
        elif mode == "second":
            answer = two_viewer_pages()
        else:
            fail(f"unknown enterprise mode: {mode}")
        sys.stdout.write(json.dumps(answer))
        return
    if values.get("slug") != "acme":
        fail(f"unknown enterprise slug: {values.get('slug')}")
    if values.get("after") != "CURSOR1":
        fail(f"unexpected cursor: {values.get('after')}")
    sys.stdout.write(json.dumps(enterprise_page(["acme-tools"], False, None)))


def issue_list(options):
    if not options.get("--repo"):
        fail("issue list needs --repo")
    issues = read_fixture("issues.json", [])
    state = options.get("--state", "")
    label = options.get("--label", "")
    search = options.get("--search", "")
    selected = []
    for issue in issues:
        if state and state != "all" and (issue.get("state") or "OPEN") != state.upper():
            continue
        if label and not any(entry.get("name") == label for entry in issue.get("labels") or []):
            continue
        haystack = (issue.get("title") or "") + " " + (issue.get("body") or "")
        if search and search.lower() not in haystack.lower():
            continue
        selected.append(issue)
    sys.stdout.write(json.dumps(project(selected, options.get("--json", ""))))


def label_create(options, positional):
    if not options.get("--repo"):
        fail("label create needs --repo")
    if positional != ["field-test"]:
        fail(f"unexpected label: {positional}")
    if not options.get("--force"):
        sys.stderr.write("gh: label already exists\n")
        sys.exit(1)
    sys.stdout.write(
        'Label "{}" created in {} ({}, {})\n'.format(
            positional[0],
            options["--repo"],
            options.get("--color", "none"),
            options.get("--description", "none"),
        )
    )


def main(argv):
    if os.environ.get("FT_GH_FIXTURE_FAIL"):
        sys.stderr.write("gh: simulated failure\n")
        return 1
    command = " ".join(argv[:2])
    options, positional = parse(argv[2:])
    if command == "api graphql":
        api_graphql(options)
    elif command == "issue list":
        issue_list(options)
    elif command == "label create":
        label_create(options, positional)
    else:
        fail(f"unsupported: {command}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
