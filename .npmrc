# Node pnpm runs scripts and installs under; downloaded if absent. Newest
# release on the 22 line (bump as 22.x releases); engines in package.json is
# the floor. The exact value is also asserted in
# .github/actions/node-pnpm/action.yml: bump both together.
use-node-version=22.23.2
# Refuse an install on a Node outside engines.
engine-strict=true
