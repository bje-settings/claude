#!/usr/bin/env bash
# A stand-in for the gh CLI, for the field-test specs. Put this directory on PATH,
# or point FT_GH at it.
#
# Like the other two stubs in this repository, it does not fake the output of the
# script under test: it holds canned answers, applies the filtering real gh applies
# server-side, projects the fields named by --json, and runs the caller's own --jq
# with real jq, so the jq in the scripts is exercised rather than assumed. Anything
# it does not emulate exits non-zero, so a spec cannot pass against a query the real
# gh would answer differently.
#
# Controlled by:
#   FT_GH_FIXTURE_DIR   directory holding issues.json and enterprise-mode
#   FT_GH_FIXTURE_FAIL  if non-empty, every call exits non-zero
#
# enterprise-mode picks the answer to the enterprise query:
#   both     one enterprise, acme-org and acme-tools both in it
#   neither  one enterprise holding only acme-org
#   paged    acme-org on the first page, acme-tools on the second
#   second   two enterprises; only the second holds both owners
#   error    the query fails
#   empty    a well-formed response with no enterprises node

set -uo pipefail

[[ -n "${FT_GH_FIXTURE_FAIL:-}" ]] && { echo "gh: simulated failure" >&2; exit 1; }

dir="${FT_GH_FIXTURE_DIR:-}"
mode="both"
[[ -n "$dir" && -f "$dir/enterprise-mode" ]] && mode="$(cat "$dir/enterprise-mode")"

cmd="${1:-}"; sub="${2:-}"; shift 2 2>/dev/null || true

query=""; slug=""; after=""; repo=""; state=""; label=""; search=""
fields=""; jq_expr="."; color=""; description=""; force=""; positional=""
while (($#)); do
  case "$1" in
    -f)
      case "${2:-}" in
        query=*) query="${2#query=}" ;;
        slug=*) slug="${2#slug=}" ;;
        after=*) after="${2#after=}" ;;
        *) echo "gh stub: unhandled -f: ${2:-}" >&2; exit 64 ;;
      esac
      shift ;;
    --repo) repo="$2"; shift ;;
    --state) state="$2"; shift ;;
    --label) label="$2"; shift ;;
    --search) search="$2"; shift ;;
    --json) fields="$2"; shift ;;
    --jq|-q) jq_expr="$2"; shift ;;
    --color) color="$2"; shift ;;
    --description) description="$2"; shift ;;
    --force) force=1 ;;
    -*) echo "gh stub: unhandled flag: $1" >&2; exit 64 ;;
    *)
      [[ -z "$positional" ]] || { echo "gh stub: unexpected second argument: $1" >&2; exit 1; }
      positional="$1" ;;
  esac
  shift
done

project() {
  local out
  out="$(printf '%s' "$1" | jq --arg fields "$fields" '
    def pick: . as $o
      | reduce ($fields | split(",")[]) as $f ({};
          if ($o | has($f)) then .[$f] = $o[$f]
          else error("Unknown JSON field: \"" + $f + "\"") end);
    if $fields == "" then .
    elif type == "array" then map(pick)
    else pick end' 2>&1)" || { echo "gh stub: $out" >&2; exit 1; }
  printf '%s' "$out" | jq -rc "$jq_expr" || exit 1
}

enterprise_page() {
  # enterprise_page <logins-json> <hasNextPage> <endCursor>
  jq -nc --argjson logins "$1" --argjson more "$2" --arg cursor "$3" \
    '{data: {enterprise: {organizations: {
        pageInfo: {hasNextPage: $more, endCursor: (if $cursor == "" then null else $cursor end)},
        nodes: [$logins[] | {login: .}]}}}}'
}

viewer_page() {
  # viewer_page <logins-json> <hasNextPage> <endCursor>
  jq -nc --argjson logins "$1" --argjson more "$2" --arg cursor "$3" \
    '{data: {viewer: {enterprises: {nodes: [{slug: "acme", organizations: {
        pageInfo: {hasNextPage: $more, endCursor: (if $cursor == "" then null else $cursor end)},
        nodes: [$logins[] | {login: .}]}}]}}}}'
}

# Two enterprises in one answer: the first holds neither owner, so a reader that
# stops at the first node gets the wrong answer.
two_viewer_pages() {
  jq -nc '{data: {viewer: {enterprises: {nodes: [
      {slug: "other", organizations: {pageInfo: {hasNextPage: false, endCursor: null},
                                      nodes: [{login: "unrelated-org"}]}},
      {slug: "acme", organizations: {pageInfo: {hasNextPage: false, endCursor: null},
                                     nodes: [{login: "acme-org"}, {login: "acme-tools"}]}}]}}}}'
}

case "$cmd $sub" in
  "api graphql")
    [[ -n "$query" ]] || { echo "gh stub: api graphql needs -f query=..." >&2; exit 1; }
    case "$mode" in
      error) echo "gh: Your token has not been granted the required scopes" >&2; exit 1 ;;
      empty) printf '%s' '{"data":{"viewer":{}}}'; exit 0 ;;
    esac
    if [[ "$query" == *viewer* ]]; then
      case "$mode" in
        both) viewer_page '["acme-org","acme-tools"]' false "" ;;
        neither) viewer_page '["acme-org"]' false "" ;;
        paged) viewer_page '["acme-org"]' true "CURSOR1" ;;
        second) two_viewer_pages ;;
      esac
      exit 0
    fi
    [[ "$slug" == "acme" ]] || { echo "gh stub: unknown enterprise slug: $slug" >&2; exit 1; }
    [[ "$after" == "CURSOR1" ]] || { echo "gh stub: unexpected cursor: $after" >&2; exit 1; }
    enterprise_page '["acme-tools"]' false ""
    exit 0 ;;

  "issue list")
    [[ -n "$repo" ]] || { echo "gh stub: issue list needs --repo" >&2; exit 1; }
    issues='[]'
    [[ -n "$dir" && -f "$dir/issues.json" ]] && issues="$(cat "$dir/issues.json")"
    filtered="$(printf '%s' "$issues" | jq -c \
      --arg state "$state" --arg lbl "$label" --arg search "$search" '
      map(select($state == "" or $state == "all" or (.state // "OPEN") == ($state | ascii_upcase)))
      | map(select($lbl == "" or any(.labels[]?; .name == $lbl)))
      | map(select($search == "" or
          ((.title + " " + (.body // "")) | ascii_downcase | contains($search | ascii_downcase))))')" \
      || { echo "gh stub: jq failed while filtering issues" >&2; exit 1; }
    project "$filtered" ;;

  "label create")
    [[ -n "$repo" ]] || { echo "gh stub: label create needs --repo" >&2; exit 1; }
    [[ "$positional" == "field-test" ]] || { echo "gh stub: unexpected label: $positional" >&2; exit 1; }
    [[ -n "$force" ]] || { echo "gh: label already exists" >&2; exit 1; }
    printf 'Label "%s" created in %s (%s, %s)\n' "$positional" "$repo" "${color:-none}" "${description:-none}" ;;

  *)
    echo "gh stub: unsupported: $cmd $sub" >&2; exit 1 ;;
esac
