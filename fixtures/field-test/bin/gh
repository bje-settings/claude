#!/usr/bin/env bash
# A stand-in for the gh CLI, for the field-test specs. Put this directory on PATH,
# or point FT_GH at it.
#
# Like the other two stubs in this repository, it does not fake the output of the
# script under test: it holds canned answers, applies the filtering real gh applies
# server-side, projects the fields named by --json, and runs the caller's own --jq
# with real jq, so the jq in the scripts is exercised rather than assumed. Anything
# it does not emulate exits non-zero, so a spec cannot pass against a query the real
# gh would answer differently.
#
# Controlled by:
#   FT_GH_FIXTURE_DIR   directory holding prs.json
#   FT_GH_FIXTURE_FAIL  if non-empty, every call exits non-zero
#
# `auth status` and `pr view` are all the harden-side scripts ask for; the run
# side is Python and its stub is tests/field-test/bin/gh.
#
# `pr view` serves prs.json. A record may carry a `sequence` array: each call
# shifts the first entry off it and merges it over the record, so a spec can watch
# a pull request move from pending to passing across polls the way a real one does.

set -uo pipefail

[[ -n "${FT_GH_FIXTURE_FAIL:-}" ]] && { echo "gh: simulated failure" >&2; exit 1; }

dir="${FT_GH_FIXTURE_DIR:-}"

cmd="${1:-}"; sub="${2:-}"; shift 2 2>/dev/null || true

repo=""; fields=""; jq_expr="."; positional=""
while (($#)); do
  case "$1" in
    --repo) repo="$2"; shift ;;
    --json) fields="$2"; shift ;;
    --jq|-q) jq_expr="$2"; shift ;;
    -*) echo "gh stub: unhandled flag: $1" >&2; exit 64 ;;
    *)
      [[ -z "$positional" ]] || { echo "gh stub: unexpected second argument: $1" >&2; exit 1; }
      positional="$1" ;;
  esac
  shift
done

project() {
  local out
  out="$(printf '%s' "$1" | jq --arg fields "$fields" '
    def pick: . as $o
      | reduce ($fields | split(",")[]) as $f ({};
          if ($o | has($f)) then .[$f] = $o[$f]
          else error("Unknown JSON field: \"" + $f + "\"") end);
    if $fields == "" then .
    elif type == "array" then map(pick)
    else pick end' 2>&1)" || { echo "gh stub: $out" >&2; exit 1; }
  printf '%s' "$out" | jq -rc "$jq_expr" || exit 1
}

case "$cmd $sub" in
  "auth status")
    echo "Logged in to github.com"; exit 0 ;;

  "pr view")
    [[ -n "$repo" ]] || { echo "gh stub: pr view needs --repo" >&2; exit 1; }
    n="${positional#\#}"; n="${n##*/}"
    [[ "$n" =~ ^[0-9]+$ ]] || { echo "gh stub: pr view needs a number or url, got: $positional" >&2; exit 1; }
    prs='[]'
    [[ -n "$dir" && -f "$dir/prs.json" ]] && prs="$(cat "$dir/prs.json")"
    rec="$(printf '%s' "$prs" | jq -c --argjson n "$n" 'map(select(.number == $n)) | .[0] // empty')" \
      || { echo "gh stub: jq failed reading prs.json" >&2; exit 1; }
    [[ -n "$rec" ]] || { echo "GraphQL: Could not resolve to a PullRequest with the number of $n." >&2; exit 1; }
    if [[ "$(printf '%s' "$rec" | jq '(.sequence // []) | length')" -gt 0 ]]; then
      printf '%s' "$prs" | jq -c --argjson n "$n" \
        'map(if .number == $n then .sequence = ((.sequence // [])[1:]) else . end)' > "$dir/prs.json.tmp" \
        && mv "$dir/prs.json.tmp" "$dir/prs.json"
      rec="$(printf '%s' "$rec" | jq -c '. + .sequence[0] | del(.sequence)')"
    else
      rec="$(printf '%s' "$rec" | jq -c 'del(.sequence)')"
    fi
    project "$rec" ;;

  *)
    echo "gh stub: unsupported: $cmd $sub" >&2; exit 1 ;;
esac
