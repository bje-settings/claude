#!/usr/bin/env bash
# A stand-in for the gh CLI, for the workstreams specs. Put this directory on PATH.
#
# Like tests/gh/bin/gh, it does not fake the output of the script under test.
# It holds canned issues, pull requests, and extensions, applies the filtering the
# real gh applies server-side, projects the fields named by --json, and runs the
# caller's own --jq expression with real jq, so the jq in the scripts is exercised
# rather than assumed. Anything it does not emulate is an error, so a spec cannot
# pass against a query the real gh would answer differently: an unknown flag exits
# 64, an unknown --json field exits 1 like gh's "Unknown JSON field", a failing
# --jq exits 1, and a second positional argument is rejected.
#
# --search is a case-insensitive substring match over title and body. Real GitHub
# search is tokenised and takes qualifiers; the scripts only forward the string,
# so specs must not read anything into which issues a search matches.
#
# Controlled by:
#   WS_GH_FIXTURE_DIR    directory holding issues.json, prs.json, extensions.txt
#                        (each optional; a missing file means an empty set)
#   WS_GH_FIXTURE_REPO   nameWithOwner reported by `gh repo view` (default below)
#   WS_GH_FIXTURE_FAIL   if non-empty, every call exits non-zero
#   WS_GH_FIXTURE_NOAUTH if non-empty, `gh auth status` fails

set -uo pipefail

[[ -n "${WS_GH_FIXTURE_FAIL:-}" ]] && { echo "gh: simulated failure" >&2; exit 1; }

dir="${WS_GH_FIXTURE_DIR:-}"
load() {
  # load <basename> <empty-value>: print the fixture file or the empty value
  if [[ -n "$dir" && -f "$dir/$1" ]]; then cat "$dir/$1"; else printf '%s' "$2"; fi
}

cmd="${1:-}"; sub="${2:-}"; shift 2 2>/dev/null || true

state=""; label=""; milestone=""; search=""; limit=1000; fields=""; jq_expr="."
positional=""
while (($#)); do
  case "$1" in
    --state) state="$2"; shift ;;
    --label) label="$2"; shift ;;
    --milestone) milestone="$2"; shift ;;
    --search) search="$2"; shift ;;
    --limit) limit="$2"; shift ;;
    --json) fields="$2"; shift ;;
    --jq|-q) jq_expr="$2"; shift ;;
    -*) echo "gh stub: unhandled flag: $1" >&2; exit 64 ;;
    *)
      [[ -z "$positional" ]] || { echo "gh stub: unexpected second argument: $1" >&2; exit 1; }
      positional="$1" ;;
  esac
  shift
done

# project <json>: apply the --json field projection, then the caller's --jq.
# Every requested field must exist on the object(s), as with real gh.
project() {
  local out
  out="$(printf '%s' "$1" | jq --arg fields "$fields" '
    def pick: . as $o
      | reduce ($fields | split(",")[]) as $f ({};
          if ($o | has($f)) then .[$f] = $o[$f]
          else error("Unknown JSON field: \"" + $f + "\"") end);
    if $fields == "" then .
    elif type == "array" then map(pick)
    else pick end' 2>&1)" || { echo "gh stub: $out" >&2; exit 1; }
  printf '%s' "$out" | jq -rc "$jq_expr" || exit 1
}

# one <file> <number> <kind>: the single record with that number, or a gh-style error
one() {
  local found
  found="$(load "$1" '[]' | jq -c --argjson n "$2" 'map(select(.number == $n)) | .[0] // empty')" \
    || { echo "gh stub: jq failed reading $1" >&2; exit 1; }
  [[ -n "$found" ]] || { echo "GraphQL: Could not resolve to $3 with the number of $2." >&2; exit 1; }
  printf '%s' "$found"
}

case "$cmd $sub" in
  "auth status")
    [[ -n "${WS_GH_FIXTURE_NOAUTH:-}" ]] && { echo "You are not logged into any GitHub hosts." >&2; exit 1; }
    echo "Logged in to github.com"; exit 0 ;;

  "extension list")
    load extensions.txt ""; exit 0 ;;

  "repo view")
    project "$(jq -cn --arg r "${WS_GH_FIXTURE_REPO:-bje-settings/example}" '{nameWithOwner:$r}')" ;;

  "issue view")
    [[ "$positional" =~ ^#?[0-9]+$ ]] || { echo "gh stub: issue view needs a number, got: $positional" >&2; exit 1; }
    rec="$(one issues.json "${positional#\#}" 'an Issue')" || exit 1
    project "$rec" ;;

  "issue list")
    # $label is renamed $lbl inside jq: label is a reserved word in jq 1.6.
    filtered="$(load issues.json '[]' | jq -c \
      --arg state "$state" --arg lbl "$label" --arg milestone "$milestone" \
      --arg search "$search" --argjson limit "$limit" '
      map(select($state == "" or $state == "all" or (.state // "OPEN") == ($state | ascii_upcase)))
      | map(select($lbl == "" or any(.labels[]?; .name == $lbl)))
      | map(select($milestone == "" or (.milestone.title // "") == $milestone))
      | map(select($search == "" or
          ((.title + " " + (.body // "")) | ascii_downcase | contains($search | ascii_downcase))))
      | .[0:$limit]')" || { echo "gh stub: jq failed while filtering issues" >&2; exit 1; }
    project "$filtered" ;;

  "pr view")
    n="${positional#\#}"; n="${n##*/}"
    [[ "$n" =~ ^[0-9]+$ ]] || { echo "gh stub: pr view needs a number or url, got: $positional" >&2; exit 1; }
    rec="$(one prs.json "$n" 'a PullRequest')" || exit 1
    project "$rec" ;;

  *)
    echo "gh stub: unsupported: $cmd $sub" >&2; exit 1 ;;
esac
