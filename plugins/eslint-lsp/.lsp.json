{
  "eslint": {
    "command": "node",
    "args": [
      "${CLAUDE_PROJECT_DIR}/node_modules/vscode-langservers-extracted/bin/vscode-eslint-language-server",
      "--stdio"
    ],
    "extensionToLanguage": {
      ".md": "markdown",
      ".json": "json"
    },
    "settings": {
      "eslint": {
        "enable": true,
        "run": "onType",
        "workingDirectory": { "mode": "auto" },
        "validate": ["markdown", "json"]
      }
    }
  }
}
