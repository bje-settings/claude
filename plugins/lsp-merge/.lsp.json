{
  "lsp-merge": {
    "command": "node",
    "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/lsp-merge.ts", "serve", "${CLAUDE_PROJECT_DIR}"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mjs": "javascript",
      ".cjs": "javascript",
      ".json": "json",
      ".jsonc": "jsonc",
      ".css": "css",
      ".scss": "scss",
      ".less": "less",
      ".html": "html",
      ".vue": "vue",
      ".svelte": "svelte",
      ".astro": "astro",
      ".graphql": "graphql",
      ".gql": "graphql",
      ".md": "markdown",
      ".mdx": "mdx",
      ".yaml": "yaml",
      ".yml": "yaml",
      ".toml": "toml",
      ".py": "python",
      ".go": "go",
      ".rs": "rust"
    },
    "restartOnCrash": true,
    "maxRestarts": 3
  }
}
