{
  "description": "Report-only sync check when a session starts. Fetches, but never changes a branch, worktree, or working tree.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "command -v python3 >/dev/null 2>&1 && python3 \"${CLAUDE_PLUGIN_ROOT}/hooks/hook-io.py\" session-start; exit 0",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
