{
  "description": "Report-only sync check when a session starts. Never modifies a repository.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 60
          }
        ]
      }
    ]
  }
}
