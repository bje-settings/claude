{
  "typescript7": {
    "command": "node",
    "args": ["${CLAUDE_PROJECT_DIR}/node_modules/typescript/bin/tsc", "--lsp", "--stdio"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".tsx": "typescriptreact",
      ".js": "javascript",
      ".jsx": "javascriptreact",
      ".mts": "typescript",
      ".cts": "typescript",
      ".mjs": "javascript",
      ".cjs": "javascript"
    }
  },
  "biome": {
    "command": "node",
    "args": ["${CLAUDE_PROJECT_DIR}/node_modules/@biomejs/biome/bin/biome", "lsp-proxy"],
    "extensionToLanguage": {
      ".ts": "typescript",
      ".mjs": "javascript",
      ".json": "json"
    }
  }
}
